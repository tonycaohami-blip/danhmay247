# Cấu hình website Đánh máy 247.
# Trên Hostinger: hPanel → Node.js app → Environment variables. Trên máy: sao chép thành .env
# KHÔNG đưa tệp .env lên GitHub.

# ===== BẮT BUỘC =====

# Mật khẩu vào trang /quan-tri (đặt dài, khó đoán)
ADMIN_PASSWORD=

# ===== NÊN CÓ: gửi email cho khách và cho bạn =====
# Gmail: bật Xác minh 2 bước, tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords
# rồi dán 16 ký tự (bỏ dấu cách) vào SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vietsciediting@gmail.com
SMTP_PASS=
MAIL_FROM=Đánh máy 247 <vietsciediting@gmail.com>
ADMIN_EMAIL=vietsciediting@gmail.com

# ===== KHÔNG BẮT BUỘC (để trống là được) =====

# Liên kết trong email — mặc định https://danhmay247.com
SITE_URL=

# Nơi lưu đơn hàng + tệp khách gửi. Để trống: tự dùng thư mục danhmay247-data
# trong thư mục gốc của tài khoản hosting (nằm ngoài code, deploy lại không mất)
DATA_DIR=

# Đối soát chuyển khoản HDBank tự động qua SePay (https://sepay.vn)
SEPAY_API_KEY=

# Dùng MySQL thay cho lưu trữ tệp (chỉ khi bạn muốn; để trống = không dùng)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Dung lượng tối đa mỗi tệp khách gửi (MB)
MAX_FILE_MB=50
