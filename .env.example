# Sao chép thành .env khi chạy trên máy, hoặc khai báo các biến này trong hPanel Hostinger
# (Node.js app → Environment variables). KHÔNG đưa tệp .env lên GitHub.

NODE_ENV=production
# Địa chỉ website thật, dùng cho liên kết trong email
SITE_URL=https://ten-mien-cua-ban.com

# Mật khẩu vào trang /quan-tri (đặt dài, khó đoán)
ADMIN_PASSWORD=

# Email nhận thông báo đơn mới
ADMIN_EMAIL=trungtamdanhmay247@gmail.com

# Gửi email qua Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" tại
# https://myaccount.google.com/apppasswords và dán vào SMTP_PASS (16 ký tự, bỏ dấu cách)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=trungtamdanhmay247@gmail.com
SMTP_PASS=
MAIL_FROM=Đánh máy 247 <trungtamdanhmay247@gmail.com>

# Đối soát chuyển khoản HDBank tự động qua SePay (https://sepay.vn) — để trống nếu xác nhận thủ công
SEPAY_API_KEY=

# Thư mục lưu đơn hàng và tệp khách gửi. Nên đặt NGOÀI thư mục code để không mất khi deploy lại,
# ví dụ trên Hostinger: /home/<user>/danhmay247-data
DATA_DIR=

# Khóa ký phiên đăng nhập (tối thiểu 32 ký tự). Để trống: tự tạo và lưu trong DATA_DIR
SESSION_SECRET=

# Dung lượng tối đa mỗi tệp (MB)
MAX_FILE_MB=50
